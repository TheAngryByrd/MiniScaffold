<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Solution.targets" />

  <PropertyGroup>
    <_FormatRoot>$(MSBuildThisFileDirectory)</_FormatRoot>
    <_FormatProjectId>$(MSBuildProjectName)-$([MSBuild]::StableStringHash('$(MSBuildProjectFullPath)'))</_FormatProjectId>
    <_DotnetFantomasOutputFile>$(BaseIntermediateOutputPath)dotnet-fantomas-$(_FormatProjectId)-$(MSBuildVersion)-$(OS)</_DotnetFantomasOutputFile>
    <_DotnetFantomasInputsFile>$(_DotnetFantomasOutputFile).inputs</_DotnetFantomasInputsFile>
  </PropertyGroup>

  <ItemGroup>
    <Watch Include="$(MSBuildThisFileFullPath)" />
    <FileWrites Include="$(_DotnetFantomasOutputFile);$(_DotnetFantomasInputsFile)" />
  </ItemGroup>

  <Target Name="_CollectFormatInputs">
    <ItemGroup>
      <_FormatInput Include="@(Compile->'%(FullPath)');$(MSBuildProjectFullPath);$(MSBuildAllProjects)" />
      <_FormatInput Include="$(MSBuildProjectDirectory)/**/*.fs;$(MSBuildProjectDirectory)/**/*.fsi;$(MSBuildProjectDirectory)/**/*.fsx;$(_FormatRoot)**/.editorconfig;$(_FormatRoot)**/.fantomasignore"
        Exclude="$(DefaultItemExcludes);**/bin/**;**/obj/**;**/.git/**" />
      <_FormatInput Include="$(_DotnetToolManifestFile);$(_FormatRoot)global.json;$(_FormatRoot)Directory.Build.targets;$(_FormatRoot)Directory.Solution.targets" />
    </ItemGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(_DotnetFantomasInputsFile)" Lines="@(_FormatInput->'%(FullPath)')"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="Format"
    Condition="'$(MSBuildProjectExtension)' == '.fsproj' AND '$(DesignTimeBuild)' != 'true' AND '$(FormatOnBuild)' != 'false'"
    DependsOnTargets="ToolRestore;_CollectFormatInputs"
    Inputs="@(_FormatInput);$(_DotnetFantomasInputsFile)" Outputs="$(_DotnetFantomasOutputFile)">
    <Exec Command="dotnet fantomas &quot;$(MSBuildProjectDirectory)&quot;"
      WorkingDirectory="$(_FormatRoot)" StandardOutputImportance="High" StandardErrorImportance="High" />
    <Touch Files="$(_DotnetFantomasOutputFile)" AlwaysCreate="True" ForceTouch="True" />
  </Target>

  <Target Name="FormatBeforeSingleTargetBuild" BeforeTargets="BeforeBuild"
    Condition="'$(TargetFrameworks)' == ''" DependsOnTargets="Format" />

  <Target Name="FormatBeforeOuterBuild" BeforeTargets="DispatchToInnerBuilds"
    Condition="'$(IsCrossTargetingBuild)' == 'true'" DependsOnTargets="Format" />

  <Target Name="FormatBeforeInnerBuild" BeforeTargets="BeforeBuild"
    Condition="'$(MSBuildProjectExtension)' == '.fsproj' AND '$(TargetFrameworks)' != '' AND '$(TargetFramework)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(FormatOnBuild)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Format" RemoveProperties="TargetFramework" />
  </Target>

  <Target Name="_CleanFormat" AfterTargets="Clean" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(_DotnetFantomasOutputFile);$(_DotnetFantomasInputsFile)" />
  </Target>
</Project>
